# ── SZINN.ai Environment Variables ──────────────────────────────────────────
# Kopieer dit bestand naar .env voor lokale ontwikkeling (server.js gebruikt dit niet direct,
# maar Netlify Dev leest .env automatisch in).

# JWT signing secret — VERPLICHT in productie, verander dit!
JWT_SECRET=szinn-jwt-verander-mij-2026

# Admin wachtwoord voor het beheer-paneel (/admin)
ADMIN_PASSWORD=szinn-admin

# AI Companion — provider-agnostisch (OpenAI-compatibel /chat/completions).
# Default is Google Gemini 2.5 Flash-Lite: goedkoop (~$0.10/$0.40 per 1M tokens),
# traint niet op je data op de betaalde tier. Sleutel via https://aistudio.google.com/apikey
# COMPANION_API_KEY=...
# COMPANION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # default
# COMPANION_MODEL=gemini-2.5-flash-lite                                        # default
#
# Wisselen van provider = alleen deze 3 vars aanpassen, geen code:
#   Mistral (EU/AVG):  BASE_URL=https://api.mistral.ai/v1            MODEL=mistral-small-latest
#   Groq (gratis):     BASE_URL=https://api.groq.com/openai/v1       MODEL=llama-3.3-70b-versatile
#   OpenRouter:        BASE_URL=https://openrouter.ai/api/v1         MODEL=...
#
# Anthropic API key — nog gebruikt voor de blueprint-generatie (niet de companion).
# ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp via Meta Cloud API — voor de dagelijkse reading-app rond 12:00 NL-tijd.
# Zonder deze wordt het appje overgeslagen en gelogd (server draait gewoon door).
# Vereist een goedgekeurde WhatsApp-template (zie lib/whatsapp.js), standaard 'daily_reading'.
# WHATSAPP_TOKEN=EAAG...                 # Meta app → WhatsApp → API Setup (tijdelijk) of System User (permanent)
# WHATSAPP_PHONE_ID=123456789012345      # Meta app → WhatsApp → API Setup → "Phone number ID"
# WHATSAPP_TEMPLATE=daily_reading

# Stripe (live) — intake-betaalpoort + abonnement €20/mnd (daily + companion).
# LET OP: zonder STRIPE_SECRET_KEY staat de intake-poort open (lokaal gemak)
# en werkt het abonnement niet — in productie (Netlify env vars) verplicht.
STRIPE_SECRET_KEY=sk_live_...
# Betaallink voor de eenmalige blueprint (redirect na betaling → /intake?session_id=…)
# INTAKE_PAY_LINK=https://buy.stripe.com/fZu9AL8g20KT5xgdpO0kE00
# Abonnementsprijs in centen (default 2000 = €20,00/mnd)
# SUB_PRICE_CENTS=2000

# Netlify Blobs context — wordt automatisch ingevuld door Netlify in productie.
# Bij gebruik van `netlify dev` lokaal is dit ook automatisch beschikbaar.
# NETLIFY_BLOBS_CONTEXT=...
